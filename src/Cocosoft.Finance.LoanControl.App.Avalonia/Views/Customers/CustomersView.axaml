<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocosoft.Finance.LoanControl.App.Avalonia.ViewModels"
             xmlns:dvm="using:Cocosoft.Finance.LoanControl.App.Avalonia.DesignTimeSupport"
             xmlns:models="using:Cocosoft.Finance.LoanControl.Domain.Customers"
             xmlns:ctrl="using:Cocosoft.Finance.LoanControl.App.Avalonia.Controls"
             x:Class="Cocosoft.Finance.LoanControl.App.Avalonia.Views.Customers.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <Design.DataContext>
    <dvm:DesignCustomersViewModel />
  </Design.DataContext>

  <Panel>
    <!-- Main View: Header + KPIs / Search Results -->
    <DockPanel IsVisible="{Binding !IsCreatingCustomer}" x:Name="MainPanel">
      <Panel IsVisible="{Binding !IsShowingDetail}" x:Name="ListPanel">
        <DockPanel>
          <!-- Add button row -->
          <Button DockPanel.Dock="Top"
                  Command="{Binding CreateCustomerCommand}"
                  AutomationProperties.Name="Crear nuevo cliente"
                  Width="40" Height="40"
                  Background="{StaticResource AccentBrush}"
                  Foreground="White"
                  CornerRadius="20"
                  Padding="0"
                  HorizontalAlignment="Right"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontSize="22"
                  FontWeight="Bold"
                  Cursor="Hand"
                  ToolTip.Tip="Crear nuevo cliente"
                  Margin="0,0,0,12"
                  Content="+" />

          <!-- Search bar -->
          <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Command="{Binding SearchCommand}"
                      AutomationProperties.Name="Buscar cliente"
                      Width="40" Height="40"
                      Background="Transparent"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      CornerRadius="20"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      FontSize="18"
                      Cursor="Hand"
                      ToolTip.Tip="Buscar"
                      Content="🔍" />
              <TextBox x:Name="SearchBox"
                       AutomationProperties.Name="Buscar cliente"
                       PlaceholderText="Buscar por número de identificación..."
                       Text="{Binding SearchText}"
                       Margin="0,0,12,0">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </DockPanel>
          </Border>

          <!-- Content area (fills remaining space) -->
          <Panel>
            <!-- KPIs (visible when not showing results) -->
            <WrapPanel IsVisible="{Binding !IsShowingResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" ItemWidth="280">
              <Border Classes="card" Margin="8" Height="120">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                  <TextBlock Text="Nuevos Clientes" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding NewCustomersCount^, FallbackValue='Cargando...'}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="8" Height="120">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                  <TextBlock Text="Total Clientes" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding TotalCustomersCount^, FallbackValue='Cargando...'}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="8" Height="120">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                  <TextBlock Text="Clientes con Préstamo Activo" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding CustomersWithActiveLoan^, FallbackValue='Cargando...'}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </WrapPanel>

            <!-- Search Results Table -->
            <Border Classes="card" IsVisible="{Binding IsShowingResults}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Resultados de Búsqueda" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <DataGrid ItemsSource="{Binding SearchResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedSearchResult}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Número de Documento" Binding="{Binding DocumentNumber}" Width="Auto" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                  </DataGrid.Columns>
                  <DataGrid.Styles>
                    <Style Selector="DataGridRow">
                      <Setter Property="Cursor" Value="Hand" />
                    </Style>
                  </DataGrid.Styles>
                </DataGrid>
              </DockPanel>
            </Border>
          </Panel>
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Create Customer View -->
    <Border Classes="card" IsVisible="{Binding IsCreatingCustomer}" Padding="24">      
      <Border DataContext="{Binding CreateCustomerForm}" x:DataType="vm:CreateCustomerViewModel">
      <DockPanel>
        <Button DockPanel.Dock="Top" Content="← Volver" Command="{Binding $parent[UserControl].((vm:CustomersViewModel)DataContext).GoBackCommand}"
                HorizontalAlignment="Left" Margin="0,0,0,16"
                Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Cursor="Hand" />

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center">
            <TextBlock Text="Crear Nuevo Cliente" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />

            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto">
              <!-- Customer section (left column) -->
              <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="Información del Cliente" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                  <TextBlock Text="Número de Documento" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding DocumentNumber}"
                           AutomationProperties.Name="Número de documento" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Nombres" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding FirstName}"
                           AutomationProperties.Name="Nombres" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Apellidos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding LastName}"
                           AutomationProperties.Name="Apellidos" />
                </StackPanel>
              </StackPanel>

              <!-- Vertical separator -->
              <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                      Margin="24,0" VerticalAlignment="Stretch" />

              <!-- Contact section (right column) -->
              <StackPanel Grid.Column="2" Spacing="12">
                <TextBlock Text="Información de Contacto" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                  <TextBlock Text="Número Celular" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding PhoneNumber}"
                           AutomationProperties.Name="Número Celular">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Correo Electrónico" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding Email}"
                           AutomationProperties.Name="Correo Electrónico">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Ciudad de Residencia" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding City}"
                           AutomationProperties.Name="Ciudad de Residencia">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Dirección de Residencia" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBox Classes="form-input" Text="{Binding Address}"
                           AutomationProperties.Name="Dirección de Residencia">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Submit Button -->
            <Button Classes="accent" Content="Registrar Cliente" Command="{Binding SubmitCommand}"
                    HorizontalAlignment="Center" Margin="0,12,0,0"
                    AutomationProperties.Name="Registrar cliente" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      </Border>
    </Border>

    <!-- Customer Detail View -->
    <DockPanel IsVisible="{Binding IsShowingDetail}">
      <Button DockPanel.Dock="Top" Content="← Volver" Command="{Binding GoBackCommand}"
              HorizontalAlignment="Left" Margin="0,0,0,12"
              Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Cursor="Hand" />

      <!-- Customer Info Header -->
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16"
              DataContext="{Binding SelectedCustomerDetail}" x:DataType="models:CustomerDto">
        <StackPanel Spacing="12">
          <!-- Row 1: Personal info -->
          <UniformGrid Columns="6">
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Número de Documento" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding IdentificationNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Nombres" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding FirstName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Apellidos" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding LastName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
          </UniformGrid>
          <!-- Row 2: Contact details -->
          <UniformGrid Columns="6">
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Número de Celular" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding PhoneNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Correo Electrónico" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding Email}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Ciudad de Residencia" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding City}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Margin="8,4" Spacing="2">
              <TextBlock Text="Dirección de Residencia" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding Address}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
    </DockPanel>
  </Panel>
</UserControl>
