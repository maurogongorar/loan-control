<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cocosoft.Finance.LoanControl.App.Avalonia.ViewModels"
             xmlns:dvm="using:Cocosoft.Finance.LoanControl.App.Avalonia.DesignTimeSupport"
             xmlns:chart="using:Cocosoft.Finance.LoanControl.App.Avalonia.Views.Charts"
             xmlns:designtimesupport="using:Cocosoft.Finance.LoanControl.App.Avalonia.DesignTimeSupport"
             x:Class="Cocosoft.Finance.LoanControl.App.Avalonia.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Design.DataContext>
    <dvm:DesignDashboardViewModel />
  </Design.DataContext>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20">
      <UniformGrid Columns="2">
        <Border Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Total Prestamos Concedidos" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TotalLoansGrantedFormatted^, FallbackValue='Cargando...'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Monto total desembolsado" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="10,0,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Total Cartera Recolectada" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TotalCollectedFormatted^, FallbackValue='Cargando...'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
            <TextBlock Text="Dinero recuperado a la fecha" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <UniformGrid Columns="2">
        <Border Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="12">
            <TextBlock Text="Distribucion de Cartera" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <chart:PieChart Width="160" Height="160" HorizontalAlignment="Center" Slice1Angle="{Binding CapitalAngle^, FallbackValue='180'}" Slice1Brush="{StaticResource AccentBrush}" Slice2Brush="{StaticResource WarningBrush}" />
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AccentBrush}" /><TextBlock FontSize="12" Text="Capital" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource WarningBrush}" /><TextBlock FontSize="12" Text="Interes" /></StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="10,0,0,0">
          <StackPanel Spacing="12">
            <TextBlock Text="Cuotas Pendientes por Recaudar" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            <Panel Height="120" HorizontalAlignment="Center" Width="220">
              <chart:GaugeChart HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Percentage="{Binding PendingDuePercentage^, FallbackValue='0'}" TrackBrush="#E2E8F0" ValueBrush="{StaticResource AccentBrush}" StrokeWidth="18" />
              <TextBlock Text="{Binding PendingDuePercentageFormatted^, FallbackValue='Cargando...'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </Panel>
            <TextBlock Text="del total de cuotas ya estan para pago" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="Acciones Rapidas" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="accent" Command="{Binding NewLoanCommand}" Margin="0,0,12,0"
                    AutomationProperties.Name="Nuevo Prestamo">
              <TextBlock Text="+ Nuevo Prestamo" />
            </Button>
            <Button Classes="primary" Command="{Binding SearchLoanCommand}" Margin="0,0,12,0"
                    AutomationProperties.Name="Buscar Prestamo">
              <TextBlock Text="Buscar Prestamo" />
            </Button>
            <Button Classes="success" Command="{Binding RegisterPaymentCommand}"
                    AutomationProperties.Name="Registrar Pago">
              <TextBlock Text="Registrar Pago" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
