<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, San Francisco, Helvetica Neue, Arial</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Segoe UI Semibold, San Francisco, Helvetica Neue, Arial</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeMedium">16</x:Double>
    <x:Double x:Key="FontSizeLarge">20</x:Double>
    <x:Double x:Key="FontSizeXLarge">24</x:Double>
    <x:Double x:Key="FontSizeHeading">28</x:Double>
</ResourceDictionary>